{
  "compilerOptions": {
    "target": "esnext",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "strictNullChecks": false,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [{ "name": "next" }],
    "paths": {
      "@/*": ["./*"],
      "react": ["../../node_modules/@types/react"],
      "react/*": ["../../node_modules/@types/react/*"],
      "react-dom": ["../../node_modules/@types/react-dom"],
      "react-dom/*": ["../../node_modules/@types/react-dom/*"],
      "@zyncat/ui/styles.css": ["../../src/styles.css"],
      "@zyncat/ui/avatar": ["../../src/components/primitives/avatar/Avatar.tsx"],
      "@zyncat/ui/avatar-group": ["../../src/components/primitives/avatar/AvatarGroup.tsx"],
      "@zyncat/ui/badge": ["../../src/components/primitives/badge/Badge.tsx"],
      "@zyncat/ui/count-badge": ["../../src/components/primitives/badge/CountBadge.tsx"],
      "@zyncat/ui/status-badge": ["../../src/components/primitives/badge/StatusBadge.tsx"],
      "@zyncat/ui/button": ["../../src/components/primitives/button/Button.tsx"],
      "@zyncat/ui/checkbox": ["../../src/components/primitives/checkbox/Checkbox.tsx"],
      "@zyncat/ui/collapse": ["../../src/components/primitives/collapse/Collapse.tsx"],
      "@zyncat/ui/number-field": ["../../src/components/primitives/input/NumberField.tsx"],
      "@zyncat/ui/otp-field": ["../../src/components/primitives/input/OtpField.tsx"],
      "@zyncat/ui/text-field": ["../../src/components/primitives/input/TextField.tsx"],
      "@zyncat/ui/radio-group": ["../../src/components/primitives/radio-group/RadioGroup.tsx"],
      "@zyncat/ui/spinner": ["../../src/components/primitives/spinner/Spinner.tsx"],
      "@zyncat/ui/tag": ["../../src/components/primitives/tag/Tag.tsx"],
      "@zyncat/ui/toggle-tag": ["../../src/components/primitives/tag/ToggleTag.tsx"],
      "@zyncat/ui/textarea": ["../../src/components/primitives/textarea/Textarea.tsx"],
      "@zyncat/ui/toggle": ["../../src/components/primitives/toggle/Toggle.tsx"],
      "@zyncat/ui/alert": ["../../src/components/composites/alert/Alert.tsx"],
      "@zyncat/ui/date-field": ["../../src/components/composites/date-picker/DateField.tsx"],
      "@zyncat/ui/date-range-field": ["../../src/components/composites/date-picker/DateRangeField.tsx"],
      "@zyncat/ui/datetime-field": ["../../src/components/composites/date-picker/DateTimeField.tsx"],
      "@zyncat/ui/time-field": ["../../src/components/composites/date-picker/TimeField.tsx"],
      "@zyncat/ui/dialog": ["../../src/components/composites/dialog/Dialog.tsx"],
      "@zyncat/ui/dropdown": ["../../src/components/composites/dropdown/Dropdown.tsx"],
      "@zyncat/ui/emoji-picker": ["../../src/components/composites/emoji-picker/EmojiPickerPanel.tsx"],
      "@zyncat/ui/modal": ["../../src/components/composites/modal/Modal.tsx"],
      "@zyncat/ui/pagination": ["../../src/components/composites/pagination/Pagination.tsx"],
      "@zyncat/ui/popover": ["../../src/components/composites/popover/Popover.tsx"],
      "@zyncat/ui/multi-select": ["../../src/components/composites/select/MultiSelect.tsx"],
      "@zyncat/ui/select": ["../../src/components/composites/select/Select.tsx"],
      "@zyncat/ui/sheet": ["../../src/components/composites/sheet/Sheet.tsx"],
      "@zyncat/ui/table": ["../../src/components/composites/table/Table.tsx"],
      "@zyncat/ui/tabs": ["../../src/components/composites/tabs/Tabs.tsx"],
      "@zyncat/ui/theme-grid": ["../../src/components/composites/theme-switcher/ThemeGrid.tsx"],
      "@zyncat/ui/theme-switcher": ["../../src/components/composites/theme-switcher/ThemeSwitcher.tsx"],
      "@zyncat/ui/toast": ["../../src/components/composites/toast/Toast.tsx"],
      "@zyncat/ui/tooltip": ["../../src/components/composites/tooltip/Tooltip.tsx"],
      "@zyncat/ui/support-rail": ["../../src/components/compound/support-rail/SupportRail.tsx"],
      "@zyncat/ui/confetti": ["../../src/components/expressive/confetti/Confetti.tsx"],
      "@zyncat/ui/facebook-feed": ["../../src/components/expressive/facebook-feed/FacebookFeed.tsx"],
      "@zyncat/ui/flow-field": ["../../src/components/expressive/flow-field/FlowField.tsx"],
      "@zyncat/ui/instagram-feed": ["../../src/components/expressive/instagram-feed/InstagramFeed.tsx"],
      "@zyncat/ui/lens": ["../../src/components/expressive/lens/Lens.tsx"],
      "@zyncat/ui/morphing-text": ["../../src/components/expressive/morphing-text/MorphingText.tsx"],
      "@zyncat/ui/odometer": ["../../src/components/expressive/odometer/Odometer.tsx"],
      "@zyncat/ui/tiktok": ["../../src/components/expressive/tiktok/TikTok.tsx"],
      "@zyncat/ui/typing-lines": ["../../src/components/expressive/typing-lines/TypingLines.tsx"],
      "@zyncat/ui/weight-field": ["../../src/components/expressive/weight-field/WeightField.tsx"],
      "@zyncat/ui/youtube": ["../../src/components/expressive/youtube/YouTube.tsx"],
      "@zyncat/ui/toast-store": ["../../src/components/composites/toast/toast-store.ts"],
      "@zyncat/ui/motion-tokens": ["../../src/tokens/motion-tokens.ts"],
      "@zyncat/ui/motion-devtools": ["../../src/components/dev/MotionDevtools.tsx"],
      "@zyncat/ui/glide": ["../../src/motion/glide.tsx"],
      "@zyncat/ui/theme": ["../../src/tokens/theme.tsx"]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".next-dev/types/**/*.ts",
    ".next/types/**/*.ts",
    "next-env.d.ts",
    ".next-verify/types/**/*.ts"
  ],
  "exclude": ["node_modules"]
}
