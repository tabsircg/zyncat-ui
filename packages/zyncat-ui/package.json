{
  "name": "zyncat-ui",
  "version": "0.16.0",
  "description": "Setup CLI for @zyncat/ui - one command installs the package and wires the project.",
  "keywords": [
    "zyncat",
    "react",
    "design-system",
    "cli",
    "init"
  ],
  "type": "module",
  "license": "MIT",
  "author": "Tabsir Ahammed",
  "homepage": "https://ui.zyncat.app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Tabsir99/zyncat-ui.git",
    "directory": "packages/zyncat-ui"
  },
  "bugs": {
    "url": "https://github.com/Tabsir99/zyncat-ui/issues"
  },
  "bin": {
    "zyncat-ui": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json",
    "prepublishOnly": "pnpm build"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@clack/prompts": "^1.7.0",
    "@types/node": "^26.0.1",
    "picocolors": "^1.1.1",
    "tsup": "^8.5.0",
    "typescript": "~6.0.3"
  }
}
